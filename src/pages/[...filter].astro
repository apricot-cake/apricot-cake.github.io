---
import { getCollection } from 'astro:content';
import { filterTree, getFilterPaths } from '../filter-tree';
import PostList from '../layouts/PostList.astro';

export function getStaticPaths() {
	return getFilterPaths(filterTree).map((filterPath) => ({
		params: { filter: filterPath.join('/') },
		props: { selectedPath: filterPath },
	}));
}

const { selectedPath } = Astro.props;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PostList posts={posts} selectedPath={selectedPath} />
