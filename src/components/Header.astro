---
import { SITE_TITLE } from '../consts';
import { siBluesky, siGithub, siPixiv } from 'simple-icons';

const socialLinks = [
 { href: 'https://bsky.app/profile/ruru-endpoint.bsky.social', label: 'Bluesky', icon: siBluesky },
 { href: 'https://www.pixiv.net/users/101930134', label: 'Pixiv', icon: siPixiv },
 { href: 'https://github.com/apricot-cake', label: 'GitHub', icon: siGithub },
];
---
<a class="fixed top-2 left-4 z-10 -translate-y-[200%] bg-white px-4 py-2 focus:translate-y-0" href="#main">本文へ移動</a>
<header class="border-b border-line bg-white">
 <div class="mx-auto flex min-h-16 max-w-[1440px] items-center justify-between gap-6 px-8 max-[641px]:min-h-15 max-[641px]:px-5">
  <a class="text-lg font-bold tracking-[0.04em] no-underline" href="/">{SITE_TITLE}</a>
  <nav aria-label="外部リンク">
   <div class="flex items-center gap-4">
    {socialLinks.map(({ href, label, icon }) => <a class="text-muted transition-colors duration-150 ease-[ease] hover:text-ink" href={href} aria-label={label}><svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon.path} /></svg></a>)}
   </div>
  </nav>
 </div>
</header>
