---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<a class="fixed top-2 left-4 z-10 -translate-y-[200%] bg-white px-4 py-2 focus:translate-y-0" href="#main">本文へ移動</a>
<header class="border-b border-line bg-white">
 <div class="mx-auto flex min-h-16 max-w-[1440px] items-center justify-between gap-6 px-8 max-[641px]:min-h-15 max-[641px]:px-5">
  <a class="text-lg font-normal tracking-[0.04em] no-underline" href="/">{SITE_TITLE}</a>
  <nav class="flex items-center gap-8 max-[641px]:gap-6" aria-label="メインナビゲーション">
   <HeaderLink href="/">Home</HeaderLink>
   <HeaderLink href="/links">Links</HeaderLink>
  </nav>
 </div>
</header>
