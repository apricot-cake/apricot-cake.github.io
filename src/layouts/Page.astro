---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
interface Props { frontmatter: { title: string }; }
const { frontmatter } = Astro.props;
---
<!doctype html>
<html lang="ja">
 <head><BaseHead title={frontmatter.title + ' | ' + SITE_TITLE} /></head>
 <body>
  <Header />
  <main id="main" class="mx-auto w-full max-w-[704px] px-8 pt-16 pb-24 max-[641px]:px-5 max-[641px]:pt-9 max-[641px]:pb-16">
   <h1 class="mb-10">{frontmatter.title}</h1>
   <div class="[&_p]:m-0 [&_p]:border-b [&_p]:border-line [&_p:first-child]:border-t [&_a]:flex [&_a]:items-center [&_a]:justify-between [&_a]:py-[22px] [&_a]:text-[15px] [&_a]:no-underline [&_a]:after:text-lg [&_a]:after:text-muted [&_a]:after:content-['↗'] [&_a:hover]:text-muted"><slot /></div>
  </main>
  <Footer />
 </body>
</html>
