---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
interface Props { frontmatter: { title: string }; }
const { frontmatter } = Astro.props;
---
<!doctype html>
<html lang="ja">
 <head><BaseHead title={frontmatter.title + ' | ' + SITE_TITLE} /></head>
 <body>
  <Header />
  <main id="main">
   <h1>{frontmatter.title}</h1>
   <div class="links"><slot /></div>
  </main>
  <Footer />
 </body>
</html>
<style>
 main { width: min(100%, 704px); margin: 0 auto; padding: 64px 32px 96px; }
 h1 { margin-bottom: 40px; }
 .links :global(p) { margin: 0; border-bottom: 1px solid var(--line); }
 .links :global(p:first-child) { border-top: 1px solid var(--line); }
 .links :global(a) { display: flex; align-items: center; justify-content: space-between; padding: 22px 0; text-decoration: none; font-size: 15px; }
 .links :global(a)::after { content: '↗'; color: var(--muted); font-size: 18px; }
 .links :global(a:hover) { color: var(--muted); }
 @media (max-width: 640px) { main { padding: 36px 20px 64px; } }
</style>
